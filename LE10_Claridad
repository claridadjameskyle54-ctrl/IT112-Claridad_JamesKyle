
#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    char studentNumber[30];
    char completeName[100];
    char section[30];
    char choice[10];

    do {
        printf("Enter Student Number: ");
        fgets(studentNumber, sizeof(studentNumber), stdin);
        studentNumber[strcspn(studentNumber, "\n")] = '\0';

        printf("Enter Complete Name: ");
        fgets(completeName, sizeof(completeName), stdin);
        completeName[strcspn(completeName, "\n")] = '\0';

        printf("Enter Section: ");
        fgets(section, sizeof(section), stdin);
        section[strcspn(section, "\n")] = '\0';

        fp = fopen("student_records.txt", "a");

        if (fp == NULL) {
            perror("File error");
            return 1;
        }

        fprintf(fp, "ID Number: %s\n", studentNumber);
        fprintf(fp, "Complete Name: %s\n", completeName);
        fprintf(fp, "Section: %s\n\n", section);

        fclose(fp);

        printf("\nRecord added and saved successfully.\n\n");

        printf("Add another student? [Enter 1 for Yes, 0 for No]: ");
        fgets(choice, sizeof(choice), stdin);

        printf("\n");

    } while (choice[0] == '1');

    printf("All student records have been saved.\n");

    return 0;
}

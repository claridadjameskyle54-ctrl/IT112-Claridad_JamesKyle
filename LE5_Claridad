#include <stdio.h>

int main() {
    int num;
    int sum = 0;

    while (1) {
        printf("Enter a number: ");
        scanf("%d", &num);

        if (num > 0) {
            sum += num;
        } else {
            break;
        }
    }

    printf("Total sum of positive numbers: %d\n", sum);

    return 0;
}
